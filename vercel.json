{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "version": 2,
  "framework": null,
  "installCommand": "echo Skipping npm install",
  "buildCommand": "echo Using prebuilt public/build",
  "outputDirectory": "public",
  "functions": {
    "api/index.php": {
      "runtime": "vercel-php@0.7.4"
    }
  },
  "routes": [
    {
      "src": "^/$",
      "dest": "/api/index.php"
    },
    {
      "src": "^/(index\\.php|\\.htaccess)$",
      "dest": "/api/index.php"
    },
    {
      "handle": "filesystem"
    },
    {
      "src": "/(.*)",
      "dest": "/api/index.php"
    }
  ],
  "env": {
    "APP_NAME": "Moodles",
    "APP_ENV": "production",
    "APP_KEY": "base64:xXDnGQ517lgWXKLtVs7sbtCAqGNQAs1fFy6qEaPIk7U=",
    "APP_DEBUG": "false",
    "APP_LOCALE": "id",
    "APP_FALLBACK_LOCALE": "id",
    "APP_CONFIG_CACHE": "/tmp/config.php",
    "APP_EVENTS_CACHE": "/tmp/events.php",
    "APP_ROUTES_CACHE": "/tmp/routes.php",
    "VIEW_COMPILED_PATH": "/tmp/storage/framework/views",
    "CACHE_STORE": "array",
    "SESSION_DRIVER": "cookie",
    "SESSION_SECURE_COOKIE": "true",
    "LOG_CHANNEL": "stderr",
    "DB_CONNECTION": "sqlite",
    "DB_DATABASE": "/tmp/database.sqlite",
    "WHATSAPP_NUMBER": "6281234567890",
    "WHATSAPP_STORE_NAME": "Moodles Banjarnegara"
  }
}
